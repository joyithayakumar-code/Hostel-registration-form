<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hostel Admission Portal — Login</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#1B2A4A;
    --cream:#F5F0E6;
    --brick:#B5533C;
    --gold:#C9A227;
    --ink:#2E2E2A;
    --paper:#FBF8F1;
    --line: rgba(27,42,74,0.18);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    font-family:'Inter', sans-serif;
    color:var(--ink);
    min-height:100vh;
    background: linear-gradient(rgba(15, 23, 42, 0.4), rgba(15, 23, 42, 0.6)),
                url('https://images.unsplash.com/photo-1562774053-701939374585?q=80&w=1920&auto=format&fit=crop') no-repeat center center fixed;
    background-size: cover;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:20px;
  }
  .login-wrapper {
    width: 100%;
    max-width: 1100px;
    display: flex;
    justify-content: flex-end;
  }
  .login-card {
    width: 100%;
    max-width: 380px;
    background: rgba(251, 248, 241, 0.95);
    backdrop-filter: blur(8px);
    border-radius: 8px;
    padding: 32px 28px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    border: 1px solid rgba(255,255,255,0.3);
  }
  .login-header h2 {
    font-family: 'Fraunces', serif;
    font-size: 24px;
    color: var(--navy);
    margin: 0 0 6px;
  }
  .login-header p {
    font-size: 13px;
    color: #5b5b52;
    margin: 0 0 24px;
  }
  .field {
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  label {
    font-size: 12px;
    font-weight: 600;
    color: var(--navy);
  }
  input {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    padding: 10px 12px;
    border: 1.5px solid var(--line);
    border-radius: 4px;
    outline: none;
    background: #fff;
  }
  input:focus {
    border-color: var(--navy);
    box-shadow: 0 0 0 3px rgba(27,42,74,0.1);
  }
  .error-msg {
    color: var(--brick);
    font-size: 12px;
    margin-top: 4px;
    display: none;
    font-family: 'JetBrains Mono', monospace;
  }
  .btn-login {
    width: 100%;
    margin-top: 8px;
    padding: 12px;
    background: var(--navy);
    color: var(--cream);
    border: none;
    border-radius: 4px;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    box-shadow: 0 4px 0 var(--brick);
    transition: transform 0.12s ease, background 0.15s ease;
  }
  .btn-login:hover { background: #233657; }
  .btn-login:active { transform: translateY(2px); box-shadow: 0 2px 0 var(--brick); }
  @media (max-width:640px){
    .login-wrapper{justify-content:center;}
  }
</style>
</head>
<body>

<div class="login-wrapper" id="loginWrapper">
  <div class="login-card">
    <div class="login-header">
      <h2>Hostel Portal Login</h2>
      <p>Enter your credentials to access the registration form.</p>
    </div>
    <form id="loginForm" onsubmit="handleLogin(event)" style="padding:0;">
      <div class="field">
        <label for="userId">User ID (25ucs501 – 25ucs565)</label>
        <input type="text" id="userId" placeholder="e.g. 25ucs501" required>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" placeholder="••••••••" required>
      </div>
      <div id="errorMsg" class="error-msg">Invalid User ID or Password.</div>
      <button type="submit" class="btn-login">Sign In</button>
    </form>
  </div>
</div>

<script>
  function handleLogin(e) {
    e.preventDefault();
    const userIdInput = document.getElementById('userId').value.trim().toLowerCase();
    const passwordInput = document.getElementById('password').value.trim();
    const errorMsg = document.getElementById('errorMsg');

    const match = userIdInput.match(/^25ucs5(\d{2})$/);
    let isValidUser = false;

    if (match) {
      const num = parseInt(match[1], 10);
      if (num >= 1 && num <= 65) {
        isValidUser = true;
      }
    }

    if (isValidUser && passwordInput === "12345678") {
      sessionStorage.setItem('rollNo', userIdInput.toUpperCase());
      window.location.href = 'application-form.html';
    } else {
      errorMsg.style.display = 'block';
      if (!isValidUser && passwordInput !== "12345678") {
        errorMsg.textContent = 'Invalid User ID and Password.';
      } else if (!isValidUser) {
        errorMsg.textContent = 'User ID must be between 25ucs501 and 25ucs565.';
      } else {
        errorMsg.textContent = 'Incorrect Password.';
      }
    }
  }
</script>

</body>
</html>
